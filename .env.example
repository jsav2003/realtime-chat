POSTGRES_DB=chat
POSTGRES_USER=chat
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5435
REDIS_PORT=6379
RABBITMQ_USER=chat
RABBITMQ_PASSWORD=change-me
RABBITMQ_PORT=5672
RABBITMQ_STOMP_PORT=61613
RABBITMQ_UI_PORT=15672
# at least 32 chars; generate with: openssl rand -base64 48
JWT_SECRET=change-me-change-me-change-me-change-me

# Cluster (docker compose --profile cluster up --build): dos instancias y un balanceador.
BACKEND_A_PORT=8081
BACKEND_B_PORT=8082
LB_PORT=8088
# Orígenes permitidos para el WebSocket, separados por coma.
WS_ALLOWED_ORIGINS=http://localhost:3000

# Límite de mensajes nuevos por usuario (token bucket). Por defecto 20 y 30 por minuto.
# El arnés de entrega manda ~80 mensajes por cliente: súbelos para una corrida rápida, o déjalos
# para ver cómo se comporta con 429.
# RATE_LIMIT_CAPACITY=20
# RATE_LIMIT_REFILL_PER_MINUTE=30
